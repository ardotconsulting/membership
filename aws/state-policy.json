{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListStateBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::ardotconsulting-tofu-state"
    },
    {
      "Sid": "ReadWriteState",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::ardotconsulting-tofu-state/members/tfstate.json",
        "arn:aws:s3:::ardotconsulting-tofu-state/repositories/tfstate.json"
      ]
    },
    {
      "Sid": "StateLockFiles",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::ardotconsulting-tofu-state/members/tfstate.json.tflock",
        "arn:aws:s3:::ardotconsulting-tofu-state/repositories/tfstate.json.tflock"
      ]
    }
  ]
}
